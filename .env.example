# ── desk-proxy configuration ─────────────────────────────────────────────────
# Location : ~/.config/desk-proxy/.env  (optional overrides; chmod 600 if used)
# Primary  : ~/.config/desk-proxy/config.json  (created by ensure_config_dir)
#
# Every key below can also be set as a process env var — env wins over JSON.
# Logging goes to stderr only (systemd/journald). No log-level env var.

# [OPTIONAL] Directory where screenshots are written.
# Empty DESK_CONFIG_DIR means use ~/.config/desk-proxy for config.json.
# Example: DESK_SHOT_DIR=/tmp/desk-proxy-shots
DESK_SHOT_DIR=/tmp/desk-proxy-shots

# [OPTIONAL] Input injection backend: auto | xdotool | ydotool.
# auto picks xdotool on X11 and ydotool on Wayland when available.
# Example: DESK_INPUT_BACKEND=auto
DESK_INPUT_BACKEND=auto

# [OPTIONAL] Tesseract OCR language pack(s), plus-separated.
# Example: DESK_OCR_LANG=eng+fra
DESK_OCR_LANG=eng+fra

# [OPTIONAL] HITL review timeout in seconds (0 or empty still defaults to 600).
# Example: DESK_HITL_TIMEOUT=600
DESK_HITL_TIMEOUT=600

# [OPTIONAL] Directory for autosaved artifacts (clips, OCR dumps, payloads).
# Example: DESK_AUTOSAVE_DIR=/tmp/desk-proxy-autosave
DESK_AUTOSAVE_DIR=/tmp/desk-proxy-autosave

# [OPTIONAL] Override the config directory. Empty = ~/.config/desk-proxy.
# Example: DESK_CONFIG_DIR=/home/kpihx/.config/desk-proxy
DESK_CONFIG_DIR=

# [OPTIONAL] Test/CI only — suppress webbrowser.open for HITL.
# Example: DESK_PROXY_NO_BROWSER=1
# DESK_PROXY_NO_BROWSER=1
